# Пример конфигурации. Скопируйте в .env или задайте переменные окружения.
# Приложение не читает .env автоматически: используйте docker compose,
# systemd EnvironmentFile или экспорт переменных в shell.

PORT=8080
HOST=0.0.0.0
DATA_DIR=./data

# auto — Secure cookie только при HTTPS (учитывает X-Forwarded-Proto при TRUST_PROXY=1).
COOKIE_SECURE=auto
TRUST_PROXY=0

# Необязательно: разрешённый Origin для проверки CSRF за обратным прокси.
# APP_ORIGIN=https://knowtomorrow.example

SESSION_DAYS=30
MIN_PRIOR_USERS=5
MAX_BODY_BYTES=2097152

# Лимиты запросов за 15 минут.
AUTH_RATE_LIMIT=12
WRITE_RATE_LIMIT=120
METRICS_RATE_LIMIT=300
ADMIN_LOGIN_RATE_LIMIT=8

# Админка /admin. Токен не короче 12 символов, лучше 32+ случайных байта.
# Без ADMIN_TOKEN админка отвечает 503, остальной сайт работает.
ADMIN_TOKEN=
ADMIN_SESSION_HOURS=12
